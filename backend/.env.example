# Resolve Backend Configuration

PROJECT_NAME="Resolve - DSA Revision System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Secret - generate a secure random string for production
SECRET_KEY="resolve-super-secret-jwt-key-change-in-production-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# For local SQLite development (default):
DATABASE_URL="sqlite:///./resolve.db"
# For Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase Credentials (optional if using direct database connection)
# Found in Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Code Execution (Judge0)
# Defaults to the free public instance (no key required).
JUDGE0_BASE_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""
# For RapidAPI instead, use:
# JUDGE0_BASE_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapidapi-key"
# JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
