# Judge0 — the public community instance at ce.judge0.com needs no API key,
# so these are optional. Set JUDGE0_API_KEY only if you want to route through
# RapidAPI instead (and be aware of its free-tier rate limits).

JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Supabase — the database and the auth provider in one. Fill these in from
# Project Settings -> API. The service-role key is server-side only: never put
# it in a VITE_ variable. With these empty the API still boots and falls back
# to the JSON catalogue and backend/data/state.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Once the database is live, the API must not trust the X-Resolve-User header.
# The browser sends its Supabase access token instead.
TRUST_CLIENT_USER_ID=false

# Optional overrides, mainly for tests and offline work:
# PRACTICE_STORE=file          # skip Supabase for practice state
# RESOLVE_CATALOGUE=json       # read the catalogue from supabase/seed/*.json
