# Dependencies
node_modules/
dist/
dist-ssr/
*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
# These patterns have no slash, so they match at any depth: backend/.env holds
# the Supabase service-role key and frontend/.env holds the Supabase anon key.
# Never commit either.
.env
.env.local
.env.*.local

# Build output
build/
coverage/

# Runtime state
# The offline fallback keeps per-user practice state on disk, not in the repo.
backend/data/

# Scratch
# The catalogue authoring pipeline is not part of the product.
temp/
