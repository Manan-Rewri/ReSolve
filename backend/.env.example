# Judge0 — the public community instance at ce.judge0.com needs no API key,
# so these are optional. Set JUDGE0_API_KEY only if you want to route through
# RapidAPI instead (and be aware of its free-tier rate limits).

JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# Supabase — the database and the auth provider in one. Leave these empty to
# boot without it; only /api/v1/health works then.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=